<Window x:Class="Hourglass.App.ClassifyPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:Hourglass.Core;assembly=Hourglass.Core"
        Title="Classify website"
        WindowStyle="None" ResizeMode="NoResize" SizeToContent="WidthAndHeight"
        Topmost="True" ShowActivated="False" ShowInTaskbar="False"
        Background="#FAF7F2" BorderBrush="{StaticResource FrameBrush}" BorderThickness="1">
    <StackPanel Margin="14,10,14,12" MinWidth="300">
        <DockPanel>
            <Button DockPanel.Dock="Right" Content="✕" MinWidth="0" Padding="6,0" Margin="8,0,0,0"
                    Background="Transparent" BorderThickness="0" ToolTip="Decide later (keeps counting backward)"
                    Click="OnLater" />
            <TextBlock FontSize="14" TextWrapping="Wrap" MaxWidth="320">
                <Run x:Name="DomainRun" FontWeight="Bold" /><Run Text=" isn't classified, so it counts backward. Count it as:" />
            </TextBlock>
        </DockPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
            <TextBlock Text="Speed:" VerticalAlignment="Center" FontSize="14" />
            <!-- Mouse only: this popup never takes keyboard focus. Type other speeds in Apps & sites. -->
            <ComboBox x:Name="SpeedBox" Width="96"
                      ItemsSource="{x:Static core:RuleItem.SpeedChoices}" SelectedIndex="0"
                      DropDownClosed="OnSpeedDropDownClosed"
                      ToolTip="Default uses the main speed. For other values, edit the site in Apps &amp; sites." />
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0">
            <Button Content="▶ Forward" Tag="Forward" Click="OnChoose" MinWidth="86" />
            <Button Content="❚❚ Pause" Tag="Pause" Click="OnChoose" MinWidth="86" />
            <Button Content="◀ Backward" Tag="Backward" Click="OnChoose" MinWidth="86" />
        </StackPanel>
    </StackPanel>
</Window>
