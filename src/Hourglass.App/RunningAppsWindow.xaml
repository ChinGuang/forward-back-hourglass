<Window x:Class="Hourglass.App.RunningAppsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:Hourglass.Core;assembly=Hourglass.Core"
        Title="Add a running app" Width="460" Height="480" MinWidth="360" MinHeight="300"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="#FAF7F2">
    <DockPanel Margin="12">
        <TextBlock DockPanel.Dock="Top" Text="Pick an open app to track:" FontSize="14" Margin="0,0,0,8" />
        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0" LastChildFill="False">
            <TextBlock DockPanel.Dock="Left" Text="Count it as:" VerticalAlignment="Center" FontSize="14" />
            <ComboBox x:Name="ActionBox" DockPanel.Dock="Left"
                      ItemsSource="{x:Static core:RulesViewModel.ActionChoices}" SelectedIndex="0" />
            <Button DockPanel.Dock="Right" Content="Cancel" IsCancel="True" />
            <Button x:Name="AddButton" DockPanel.Dock="Right" Content="Add" IsDefault="True" Click="OnAdd"
                    IsEnabled="{Binding SelectedItem, ElementName=AppList, Converter={StaticResource NotNull}}" />
        </DockPanel>
        <TextBlock x:Name="LoadingText" DockPanel.Dock="Top" Text="Looking for open apps…" Margin="0,0,0,6" />
        <ListBox x:Name="AppList" MouseDoubleClick="OnAdd">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal" Margin="2">
                        <Image Source="{Binding Icon}" Width="24" Height="24" Margin="0,0,8,0" />
                        <StackPanel>
                            <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Title}" Foreground="Gray" TextTrimming="CharacterEllipsis" MaxWidth="340" />
                        </StackPanel>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
