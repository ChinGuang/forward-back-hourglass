<Application x:Class="Hourglass.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Hourglass.App"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <SolidColorBrush x:Key="FrameBrush" Color="#3C2A1E" />
        <SolidColorBrush x:Key="SandBrush" Color="#E8B03E" />
        <SolidColorBrush x:Key="GlassBrush" Color="#D6EAF8" />
        <SolidColorBrush x:Key="AccentBrush" Color="#2E6DA4" />
        <SolidColorBrush x:Key="AlertBrush" Color="#C0392B" />
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <local:NotNullConverter x:Key="NotNull" />

        <Style TargetType="Button">
            <Setter Property="MinWidth" Value="96" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Margin" Value="4" />
            <Setter Property="FontSize" Value="15" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="MinWidth" Value="80" />
            <Setter Property="Margin" Value="4" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </Application.Resources>
</Application>
